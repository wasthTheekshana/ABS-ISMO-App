# Copy to ~/absismo-stack/.env on the server and fill in every value. Never commit the real file.

# Public address of the app (no https://, no trailing slash). The A record must point to 34.93.171.14.
ISOMS_DOMAIN=ismo.testsys.shop

# Database. Choose a long random password:  openssl rand -base64 24
POSTGRES_DB=isoms_db
POSTGRES_USER=isoms_app
POSTGRES_PASSWORD=CHANGE_ME

# Signs every sign-in token. Make a NEW value for this server:  openssl rand -base64 48
# Do not reuse the example from the development .env.example. Anyone who knows it can forge a login.
JWT_SECRET=CHANGE_ME

# Swagger API documentation at /api/docs. Set to false to switch it off.
DOCS_ENABLED=true
